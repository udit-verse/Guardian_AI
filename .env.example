# Optional: retained for compatibility; not currently referenced by backend code.
OPENAI_API_KEY=

# Leave empty for local SQLite fallback.
# Production: use the Render PostgreSQL connection URL.
DATABASE_URL=

# Legacy/optional placeholder; backend authentication uses JWT_SECRET_KEY.
SECRET_KEY=

# Required: generate a strong, unique production secret.
JWT_SECRET_KEY=

# Required for AI claim extraction and verification.
GEMINI_API_KEY=

# Comma-separated frontend origins.
# Replace with the actual Vercel domain in Render.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
